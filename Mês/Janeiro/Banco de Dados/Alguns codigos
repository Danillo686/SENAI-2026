
CREATE TABLE EMPREGADO(
	ID_EMPREGADO SERIAL PRIMARY KEY,
	SALARIO VARCHAR(200),
	NOME VARCHAR(200),
	IDADE INT NOT NULL,
	SEXO VARCHAR(200)
);

UPDATE EMPREGADO SET NOME = 'FEMININO'
WHERE NOME = 'CARLOS'

