CREATE OR REPLACE FUNCTION CLIENTE_ALT()
RETURNS TRIGGER AS 
$$
	BEGIN
		INSERT INTO LOG_CLIENTE (CIDADE_ATUAL, CIDADE_ANTERIOR, NOME_ATUAL, NOME_ANTERIOR, UF_ATUAL, UF_ANTERIOR, DATA_ALT)
		VALUES (NEW.CIDADE, OLD.CIDADE, NEW.NOME, OLD.NOME, NEW.UF, OLD.UF, NOW());
		RETURN NEW;
	END;
$$ LANGUAGE PLPGSQL;

CREATE OR REPLACE TRIGGER LOG_CLIENTE_ALT
AFTER UPDATE ON CLIENTE
FOR EACH ROW
EXECUTE PROCEDURE CLIENTE_ALT();

