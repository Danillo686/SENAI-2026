CREATE TABLE LOG_PRODUTO(
	ID_LOG SERIAL PRIMARY KEY,
	ID_PROD INT,
	PRECO_ANTERIOR NUMERIC(10, 2),
	PRECO_ATUAL NUMERIC (10, 2)
);

ALTER TABLE LOG_PRODUTO ADD COLUMN DATA_ALT DATE
ALTER TABLE LOG_PRODUTO ADD COLUMN HORA_ALT TIME

CREATE OR REPLACE FUNCTION PROD_LOG()
RETURNS TRIGGER AS $$
BEGIN
    INSERT INTO LOG_PRODUTO (ID_PROD, PRECO_ANTERIOR, PRECO_ATUAL, DATA_ALT, HORA_ALT)
    VALUES (NEW.ID_PRODUTO, OLD.PRECO, NEW.PRECO, NOW());
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE TRIGGER TG_PROD_LOG
AFTER UPDATE ON PRODUTO 
FOR EACH ROW 
EXECUTE PROCEDURE PROD_LOG();

