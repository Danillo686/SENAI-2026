CREATE TABLE ATUALIZACAO_SALARIAL (
	LOG_ALTERACAO SERIAL PRIMARY KEY,
	MATRICULA_FUNC INT NOT NULL,
	DATA_ALTERACAO TIMESTAMP NOT NULL,
	SAL_ANTERIOR FLOAT NOT NULL,
	SAL_ATUAL FLOAT NOT NULL,
	RESPONSAVEL VARCHAR(20)
);

