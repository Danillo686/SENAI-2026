--FUNÇÃO PRA CRIPTOGRAFAR O CPF

CREATE OR REPLACE FUNCTION criptografar_para_bytea(p_cpf TEXT, p_chave TEXT) 
RETURNS BYTEA AS $$
BEGIN
    -- O retorno de encrypt() já é BYTEA, perfeito para sua tabela
    RETURN encrypt(p_cpf::bytea, p_chave::bytea, 'aes');
END;
$$ LANGUAGE plpgsql;

--------------------------------------------------------------------------------------------------------------------------------------------------------------------------

--FUNÇÃO PARA DESCRIPTOGRAFAR O CPF

CREATE OR REPLACE FUNCTION ler_cpf_original(p_cpf_bytea BYTEA, p_chave TEXT) 
RETURNS TEXT AS $$	
BEGIN
    RETURN convert_from(decrypt(p_cpf_bytea, p_chave::bytea, 'aes'), 'utf8');
END;
$$ LANGUAGE plpgsql;


