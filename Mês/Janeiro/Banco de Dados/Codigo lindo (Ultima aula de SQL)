--LOG AUDITORIA 
CREATE TABLE LOG_AUDITORIA (
	ID_LOG SERIAL PRIMARY KEY,
	USUARIO TEXT, --NOME DE QUEM MUDOU
	OPERACAO TEXT, --O QUE ELE FEZ (DELETE, INSERT, UPDATE)
	TABELA TEXT, -- NOME DA TABELA
	DATA_HORA TIMESTAMP, -- HORA DA ATUALIZAÇÃO
	DADOS_ANTERIORES TEXT,	-- DADOS ANTIGOS 
	DADOS_NOVOS TEXT -- DADOS NOVOS
);

--------------------------------------------------------------------------------------------------------------------------------------------------------------------------
--TRIGER PARA TER O LOG 
CREATE OR REPLACE FUNCTION LOG_AUDITORIA_ALT()
RETURNS TRIGGER AS 
$$
	BEGIN 
		INSERT INTO LOG_AUDITORIA (USUARIO, OPERACAO, TABELA, DATA_HORA, DADOS_ANTERIORES, DADOS_NOVOS)
		VALUES (
            CURRENT_USER, 
            TG_OP, 
            TG_TABLE_NAME, 
            NOW(), 
            to_jsonb(OLD)::text,
            to_jsonb(NEW)::text
        );
		RETURN NEW;
	END;
$$ LANGUAGE PLPGSQL;

-- Para a tabela CLIENTE
CREATE OR REPLACE TRIGGER TRG_AUDITORIA_CLIENTE
AFTER INSERT OR UPDATE OR DELETE ON CLIENTE
FOR EACH ROW EXECUTE FUNCTION LOG_AUDITORIA_ALT();

-- Para a tabela PRODUTO
CREATE OR REPLACE TRIGGER TRG_AUDITORIA_PRODUTO
AFTER INSERT OR UPDATE OR DELETE ON PRODUTO
FOR EACH ROW EXECUTE FUNCTION LOG_AUDITORIA_ALT();

-- Para a tabela PEDIDO
CREATE OR REPLACE TRIGGER TRG_AUDITORIA_PEDIDO
AFTER INSERT OR UPDATE OR DELETE ON PEDIDO
FOR EACH ROW EXECUTE FUNCTION LOG_AUDITORIA_ALT();

