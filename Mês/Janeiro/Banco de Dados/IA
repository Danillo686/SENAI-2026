# 🎯 Desafio: Prever se um funcionário será promovido
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score, confusion_matrix
from sklearn.preprocessing import LabelEncoder
import plotly.express as px

table = pd.read_csv('Funcionario.csv', encoding='latin1')
table.dropna()
table

print(table['Departamento'])


from sklearn.preprocessing import LabelEncoder

# Encoder para Departamento
encoder_departamento = LabelEncoder()
table['Departamento'] = encoder_departamento.fit_transform(table['Departamento'])

# Encoder para Nome
encoder_nome = LabelEncoder()
table['Nome'] = encoder_nome.fit_transform(table['Nome'])

# Graficos
fig = px.pie(table, names='Departamento', color='Departamento')
fig.show()

fig = px.bar(table, y='SalarioMensal', x='AnosNaEmpresa')
fig.show()
x = table[['Idade', 'SalarioMensal', 'AnosNaEmpresa', 'ProjetosConcluidos', 'TreinamentosFeitos', 'AvaliacoesPositivas', 'HorasExtrasMes']]
y = table[['Promovido']]
#Usado para codar ( - > passar para numero, tipo id pra cada profissão) o departamento, já que são strings e a IA não lê string

x_train, x_test, y_train, y_test = train_test_split(x, y, random_state=42, test_size=0.3)

model = RandomForestClassifier()
model.fit(x_train, y_train)

y_pred = model.predict(x_test)

