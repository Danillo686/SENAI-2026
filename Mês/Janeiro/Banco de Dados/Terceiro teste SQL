CREATE VIEW CALCULA_IDADE AS
SELECT NOME, (EXTRACT(YEAR FROM CURRENT_DATE) - EXTRACT(YEAR FROM DATA_NASC)) AS IDADE FROM CLIENTE
SELECT * FROM CALCULA_IDADE
WHERE IDADE = 60
ORDER BY IDADE DESC;

