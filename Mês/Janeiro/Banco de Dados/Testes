-- Cria uma função que insere um produto na tabela PRODUTO
CREATE OR REPLACE FUNCTION INSERE_PROD(DES TEXT, CAT TEXT, VAL NUMERIC)
RETURNS VARCHAR AS 
$$
    DECLARE MSG TEXT; -- Variável para mensagem de retorno
    BEGIN
        INSERT INTO PRODUTO(DESCRICAO, CATEGORIA, PRECO)
        VALUES(DES, CAT, VAL); -- Insere os dados na tabela
        MSG = 'PRODUTO SALVO COM SUCESSO'; -- Mensagem de confirmação
        RETURN MSG; -- Retorna a mensagem
    END;
$$ LANGUAGE PLPGSQL;

-- Executa a função para inserir uma caneta
SELECT INSERE_PROD('CANETA', 'PAPELARIA', 5.25);
